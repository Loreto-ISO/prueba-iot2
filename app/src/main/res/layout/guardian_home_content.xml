<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/guardian_screen_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/dashboard_header_height" android:background="@color/guardian_header_blue" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="@dimen/dashboard_page_margin" android:paddingEnd="@dimen/dashboard_page_margin" android:paddingTop="8dp" android:paddingBottom="8dp">
            <ImageView android:id="@+id/ivHomeLogo" android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/logo_guardianapp" android:scaleType="fitCenter" android:contentDescription="@string/app_name" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvScreenTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:text="@string/home_header_tutor" android:textColor="@color/white" android:textSize="21sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvHomeName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/home_house_short" android:textColor="@color/white" android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView android:id="@+id/homeScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/dashboard_page_margin" android:paddingEnd="@dimen/dashboard_page_margin" android:paddingTop="24dp" android:paddingBottom="20dp">
                <TextView android:id="@+id/tvSelectedDoor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="22dp" android:text="@string/selected_door_default" android:textColor="@color/guardian_primary_text" android:textSize="23sp" android:textStyle="bold" />

                <LinearLayout android:id="@+id/statusCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="142dp" android:background="@drawable/bg_status_neutral" android:elevation="4dp" android:gravity="center_vertical" android:orientation="horizontal" android:padding="20dp">
                    <ImageView android:id="@+id/ivDoorStatus" android:layout_width="58dp" android:layout_height="58dp" android:layout_marginEnd="18dp" android:contentDescription="@string/state_icon_disconnected" android:src="@drawable/ic_state_bluetooth_off" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/tvOverallState" android:layout_width="match_parent" android:layout_height="wrap_content" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="27sp" android:autoSizeMaxTextSize="37sp" android:autoSizeStepGranularity="1sp" android:maxLines="1" android:ellipsize="none" android:text="@string/status_title_disconnected" android:textColor="@color/guardian_disconnected" android:textSize="36sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvStatusDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:maxLines="3" android:text="@string/status_description_disconnected" android:textColor="@color/guardian_primary_text" android:textSize="16sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView android:id="@+id/tvDemoBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="10dp" android:background="@drawable/bg_demo_badge" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:text="@string/status_mode_demo" android:textColor="@color/guardian_header_dark" android:textSize="13sp" android:textStyle="bold" android:visibility="gone" />

                <LinearLayout android:id="@+id/deviceSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_status_card" android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/tvDoorState" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/status_door_label" android:textColor="@color/guardian_primary_text" android:textSize="16sp" />
                    <TextView android:id="@+id/tvDistance" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/status_distance_pending" android:textColor="@color/guardian_primary_text" android:textSize="16sp" />
                    <TextView android:id="@+id/tvSensor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/sensor_pending" android:textColor="@color/guardian_secondary_text" android:textSize="14sp" />
                    <TextView android:id="@+id/tvBluetoothState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/bluetooth_disconnected" android:textColor="@color/guardian_secondary_text" android:textSize="14sp" />
                    <TextView android:id="@+id/tvLastRead" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/status_last_update_pending" android:textColor="@color/guardian_secondary_text" android:textSize="14sp" />
                    <TextView android:id="@+id/tvLed" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/status_led_pending" android:textColor="@color/guardian_secondary_text" android:textSize="14sp" android:visibility="gone" />
                    <TextView android:id="@+id/tvBuzzer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/status_buzzer_pending" android:textColor="@color/guardian_secondary_text" android:textSize="14sp" android:visibility="gone" />
                </LinearLayout>

                <TextView android:id="@+id/tvTechnicalDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_status_card" android:padding="14dp" android:text="@string/no_data" android:textColor="@color/guardian_secondary_text" android:textSize="14sp" android:visibility="gone" />

                <Button android:id="@+id/btnOpenBluetooth" android:layout_width="match_parent" android:layout_height="@dimen/dashboard_button_height" android:layout_marginTop="18dp" android:background="@drawable/bg_primary_action" android:drawableStart="@drawable/ic_action_bluetooth" android:drawablePadding="14dp" android:gravity="center" android:minHeight="48dp" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="@string/action_connect_bluetooth" android:textAllCaps="false" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" />
                <Button android:id="@+id/btnFindDoors" android:layout_width="match_parent" android:layout_height="@dimen/dashboard_button_height" android:layout_marginTop="10dp" android:background="@drawable/bg_primary_action" android:drawableStart="@drawable/ic_action_doors" android:drawablePadding="14dp" android:gravity="center" android:minHeight="48dp" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="@string/action_search_doors" android:textAllCaps="false" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" />
                <Button android:id="@+id/btnOpenProfile" android:layout_width="match_parent" android:layout_height="@dimen/dashboard_button_height" android:layout_marginTop="10dp" android:background="@drawable/bg_primary_action" android:drawableStart="@drawable/ic_nav_profile" android:drawablePadding="14dp" android:gravity="center" android:minHeight="48dp" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="@string/action_profile" android:textAllCaps="false" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" />
                <Button android:id="@+id/btnDiagnostics" android:layout_width="match_parent" android:layout_height="@dimen/dashboard_button_height" android:layout_marginTop="10dp" android:background="@drawable/bg_primary_action" android:gravity="center" android:minHeight="48dp" android:text="@string/open_diagnostics" android:textAllCaps="false" android:textColor="@color/white" android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
        <include layout="@layout/guardian_bottom_navigation" />
    </LinearLayout>
</FrameLayout>
