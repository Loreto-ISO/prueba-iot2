<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Panel Administrador / Pruebas"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#9C27B0"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Modo Administrador activado. Puedes probar la interfaz del sensor o gestionar el sistema."
        android:gravity="center"
        android:layout_marginBottom="30dp"/>

    <Button
        android:id="@+id/btnGoToDashboardTest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Abrir Monitor de Sensores (Pruebas)"/>

    <Button
        android:id="@+id/btnLogoutAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cerrar Sesión"
        android:backgroundTint="#666666"
        android:layout_marginTop="20dp"/>
</LinearLayout>