<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Monitor Inteligente IoT"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:text="Estado: Puerta Cerrada y Segura"
        android:textSize="18sp"
        android:textColor="#009900"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#EEEEEE"
        android:layout_marginBottom="40dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Controles de Simulación (Sin Arduino)"
        android:textSize="14sp"
        android:textStyle="italic"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnSimularProximidad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Simular: Movimiento Detectado (Ultrasonido)"/>

    <Button
        android:id="@+id/btnSimularApertura"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Simular: Puerta Abierta (Botón/Magnético)"
        android:backgroundTint="#FF0000"/>

    <Button
        android:id="@+id/btnSimularCierre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Simular: Puerta Cerrada (Reinicio)"/>
</LinearLayout>